# Test --respect-lcov-exclusions with llvm-cov export
# This test verifies that LCOV exclusion markers are respected during export.

# Create a source file with LCOV exclusion markers
RUN: mkdir -p %T/lcov-excl-test
RUN: cat > %T/lcov-excl-test/test.c << 'EOF'
void simple_loops() {
  int i;
  for (i = 0; i < 100; ++i) {   // LCOV_EXCL_LINE
  }
  while (i > 0)
    i--;
  do {} while (i++ < 75);
}

void conditionals() {
  // LCOV_EXCL_START
  for (int i = 0; i < 100; ++i) {
    if (i % 2) {
      if (i) {}
    }
  }
  // LCOV_EXCL_STOP
}

void early_exits() {
  int i = 0;
  if (i) {}
  while (i < 100) {
    i++;
    if (i > 50)
      break;
    if (i % 2)
      continue;
  }
  if (i) {}
  do {
    if (i > 75)
      return;
    else
      i++;
  } while (i < 100);
  if (i) {}
}

int main() {
  simple_loops();
  conditionals();
  early_exits();
  return 0;
}
EOF

# Copy the source to the expected path for the object file
RUN: cp %T/lcov-excl-test/test.c /tmp/branch-c-general.c

# Test LCOV format export without exclusions - should include line 9
RUN: llvm-cov export --format=lcov %S/Inputs/branch-c-general.o32l -instr-profile %S/Inputs/branch-c-general.proftext %T/lcov-excl-test/test.c 2>&1 | FileCheck %s --check-prefix=NOEXCL

# Test LCOV format export with exclusions - should exclude line 9 (LCOV_EXCL_LINE)
RUN: llvm-cov export --format=lcov --respect-lcov-exclusions %S/Inputs/branch-c-general.o32l -instr-profile %S/Inputs/branch-c-general.proftext %T/lcov-excl-test/test.c 2>&1 | FileCheck %s --check-prefix=EXCL

# Test JSON format export with exclusions
RUN: llvm-cov export --format=text --respect-lcov-exclusions %S/Inputs/branch-c-general.o32l -instr-profile %S/Inputs/branch-c-general.proftext %T/lcov-excl-test/test.c 2>&1 | FileCheck %s --check-prefix=JSON-EXCL

# NOEXCL: SF:
# NOEXCL: DA:9,{{[0-9]+}}
# NOEXCL: end_of_record

# EXCL: SF:
# EXCL-NOT: DA:9,{{[0-9]+}}
# EXCL: end_of_record

# JSON-EXCL: "version":
# JSON-EXCL: "data":
# JSON-EXCL: "filename":
# JSON-EXCL: "summary":
